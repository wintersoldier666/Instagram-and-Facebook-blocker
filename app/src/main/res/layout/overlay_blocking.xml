<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F2080810"
    android:padding="28dp">

    <!-- Shield glyph with glow ring -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1A7C3AED"
        app:cardCornerRadius="44dp"
        app:strokeColor="#447C3AED"
        app:strokeWidth="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🛡"
            android:textSize="40sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- App Name + status -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instagram"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="is blocked"
        android:textColor="#66FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="28dp" />

    <!-- Info card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#161625"
        app:cardCornerRadius="16dp"
        app:strokeColor="#2A2A3E"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This app is blocked"
                android:textColor="#DDDDDD"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp"
                android:lineSpacingMultiplier="1.3" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1FFFFFFF"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ "
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_screentime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 min used today"
                    android:textColor="#7C3AED"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quote card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="#0F1A0F"
        app:cardCornerRadius="16dp"
        app:strokeColor="#1A3A1A"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="16sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tv_quote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your attention is your most valuable resource."
                android:textColor="#AADDAA"
                android:textSize="13sp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Primary button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_home"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Go Back"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#7C3AED"
        android:layout_marginBottom="10dp" />

    <!-- Snooze button (shown only for session limits) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_snooze"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Allow 5 more minutes"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
