<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#DD000000"
    android:padding="28dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#12121E"
        app:cardCornerRadius="20dp"
        app:strokeColor="#2A2A40"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Icon row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="32sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_popup_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instagram"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Check-in"
                android:textColor="#557C3AED"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Screentime info card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A1A30"
                app:cardCornerRadius="12dp">

                <TextView
                    android:id="@+id/tv_popup_screentime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You haven't used Instagram yet today."
                    android:textColor="#CCDDFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="14dp"
                    android:lineSpacingMultiplier="1.4" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Quote -->
            <TextView
                android:id="@+id/tv_popup_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sample_quote"
                android:textColor="#888899"
                android:textSize="13sp"
                android:gravity="center"
                android:fontFamily="serif"
                android:layout_marginBottom="24dp"
                android:lineSpacingMultiplier="1.5" />

            <!-- Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_continue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="I'll be mindful — Continue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#7C3AED"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_popup_block"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Block for today"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
